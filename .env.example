# Server Configuration
PORT=5000
NODE_ENV=development
# Allowed browser origin(s) for CORS. Comma-separate several, e.g. https://solahana.vercel.app,https://www.yourdomain.com
CLIENT_URL=http://localhost:5173
# Reverse-proxy hops in front of the API (Render = 1). Used so rate limiting sees the real visitor IP.
TRUST_PROXY_HOPS=1

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/solahana?retryWrites=true&w=majority

# Authentication / JWT Configuration
# REQUIRED in production (server refuses to start without it). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Cloudinary Storage Configuration (Placeholder)
CLOUDINARY_CLOUD_NAME=solahana_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service Configuration (Placeholder)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_username
EMAIL_PASS=your_email_password
EMAIL_FROM=advisory@solahana.com

# Where new lead alerts are sent (the advisor who makes the calls)
ADVISOR_EMAIL=amit@solahana.com

# Used once by: npm run create-admin
ADMIN_EMAIL=amit@solahana.com
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Amit Pandey

# ---- Frontend (Vercel build-time variable, NOT read by the server) ----
# Public URL of the deployed API, no trailing slash. Leave empty locally (Vite proxies /api to localhost:5000).
# On Vercel this MUST be set to the Render URL, otherwise /api calls hit the static site and the forms fail.
VITE_API_URL=
